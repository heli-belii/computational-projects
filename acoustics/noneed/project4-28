import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.fft import fft, ifft, fftfreq
import librosa as lb

def unwind(a):
    return np.roll(a, len(a) // 2)

def Generator(filename):
   
   Waveform, Sample_Rate = lb.load(filename, sr=None) # keeps the sampling rate of the audio file
   Duration = len(Waveform) / Sample_Rate
   print(f"The duration of the recording is {Duration}")

   Time = np.arange(0, Duration, 1/Sample_Rate)
   Nyquist_Frequency = Sample_Rate / 2
   FFT = fft(Waveform)
   return Waveform, Time, Nyquist_Frequency, FFT, filename

def Plotter(Waveform, Time, Nyquist_Frequency, FFT, Max_Freq, Start_ratio, End_ratio, filename):
   
   fig, ax = plt.subplots(nrows=2, ncols=2)

    ###Nyquist requires rows = 3

   fig.suptitle(f"Waveform and FFT Analysis for {filename}")
   start_time = int(Start_ratio * len(Waveform))
   end_time = int(End_ratio * len(Waveform))
   Sample_Rate = 2 * Nyquist_Frequency

   ax[0][0].plot(Time[start_time:end_time], np.real(Waveform)[start_time:end_time], label = "Real Waveform")
   ax[0][0].set_title("Waveform: real part")
   ax[0][0].set_xlabel("Time [s]")
   ax[0][0].set_ylabel("Pressure")
   ax[0][1].plot(Time[start_time:end_time], np.imag(Waveform)[start_time:end_time], label = "Imaginary Waveform")
   ax[0][1].set_title("Waveform: imaginary part")
   ax[0][1].set_xlabel("Time [s]")
   ax[0][1].set_ylabel("Pressure")

   Freqs = fftfreq(len(FFT), 1/Sample_Rate)
   FFT_Real = np.real(FFT)
   FFT_Imag = np.imag(FFT)

   ax[1][0].plot(unwind(Freqs), unwind(FFT_Real), label="Real FFT")
   ax[1][0].set_title(f"Zoomed FFT: real part, +/-{Max_Freq} Hz")
